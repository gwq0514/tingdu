# Private, single-owner validation only. Do not enable as an anonymous public service.
# Adapt certificate paths and auth file in 1Panel/OpenResty; do not start a second listener.
server {
    listen 443 ssl;
    server_name tingdu.online www.tingdu.online;
    ssl_certificate /etc/tingdu/tls/fullchain.pem;
    ssl_certificate_key /etc/tingdu/tls/privkey.pem;
    auth_basic "Tingdu private pilot";
    auth_basic_user_file /etc/tingdu/pilot.htpasswd;
    client_max_body_size 2g;
    location / {
        proxy_pass http://127.0.0.1:8768;
        proxy_set_header Host 127.0.0.1:8768;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
server {
    listen 80;
    server_name tingdu.online www.tingdu.online;
    return 301 https://$host$request_uri;
}
