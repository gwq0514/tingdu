# Copy to /etc/tingdu/pilot.env. Do not commit secrets or user content.
TINGDU_PROFILE=server-2gb
TINGDU_DATA_DIR=/var/lib/tingdu-pilot/data
TINGDU_PORT=8768
TINGDU_OLLAMA_BIN=/usr/local/bin/ollama
OLLAMA_MODELS=/var/lib/tingdu-pilot/data/ollama
TINGDU_LLM_MODEL=tingdu-qwen:latest
# Set only when enabling the authenticated HTTPS pilot. Origin is never rewritten.
# TINGDU_ALLOWED_ORIGINS=https://tingdu.online,https://www.tingdu.online
